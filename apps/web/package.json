{
  "name": "@aura/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aura frontend — React + Vite + TypeScript.",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace @aura/shared",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@aura/shared": "*",
    "framer-motion": "^13.0.0",
    "livekit-client": "^2.15.8",
    "lucide-react": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11"
  }
}
