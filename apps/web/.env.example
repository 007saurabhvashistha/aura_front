# ---- Aura Web (apps/web) ----
# Copy to .env. Vite only exposes vars prefixed with VITE_.
#
# Local dev: leave empty to stay same-origin via the Vite proxy (vite.config.ts).
# Production (Vercel): set to the Render API origin, e.g. https://aura-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000
